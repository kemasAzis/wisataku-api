generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Destinasi {
  id         Int      @id @default(autoincrement())
  nama       String
  kategori   String
  hargaTiket Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}